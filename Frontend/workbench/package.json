{
  "name": "workbench",
  "version": "0.1.0",
  "private": true,
  "main": "public/electron.js",
  "homepage": "./",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@heyirisai/docx-editor-core": "1.11.0",
    "@heyirisai/docx-editor-react": "1.11.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "axios": "1.19.0",
    "axios-retry": "^4.5.0",
    "bootstrap": "^5.3.7",
    "chart.js": "^4.4.9",
    "chartjs-plugin-zoom": "^2.2.0",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.0",
    "katex": "^0.16.45",
    "mathjs": "^15.2.0",
    "pdf-lib": "^1.17.1",
    "plotly.js-dist": "^3.6.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.2.8",
    "react-icons": "^5.5.0",
    "react-katex": "^3.1.0",
    "react-plotly.js": "^2.6.0",
    "react-router": "^8.3.0",
    "react-select": "^5.10.2",
    "recharts": "^3.8.1",
    "simple-statistics": "^7.8.8",
    "stream-browserify": "3.0.0",
    "three": "^0.184.0",
    "util": "0.12.5",
    "uuid": "^14.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "brace-expansion@1": "^1.1.18",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:backend": "cd ../../Backend/ac_shunt && ..\\..\\venv\\Scripts\\python.exe manage.py bootstrap && ..\\..\\venv\\Scripts\\python.exe manage.py runserver 0.0.0.0:8000",
    "start:remote": "vite --host 0.0.0.0 --port 3100",
    "start:backend:remote": "cd ../../Backend/ac_shunt && ..\\..\\venv\\Scripts\\python.exe manage.py bootstrap && ..\\..\\venv\\Scripts\\python.exe manage.py runserver 0.0.0.0:8100",
    "dev": "concurrently \"npm run start:backend\" \"npm start\"",
    "dev:remote": "cross-env VITE_BACKEND_PORT=8100 concurrently \"npm run start:backend:remote\" \"npm run start:remote\"",
    "dev:tunnel": "cross-env VITE_BACKEND_PORT=8100 VITE_API_SAME_ORIGIN=1 concurrently \"npm run start:backend:remote\" \"npm run start:remote\"",
    "dev:mock": "cross-env MOCK_INSTRUMENTS=1 concurrently \"npm run start:backend\" \"npm start\"",
    "electron:dev": "concurrently \"npm run start:backend\" \"cross-env BROWSER=none npm start\" \"wait-on tcp:3000 tcp:8000 && .\\node_modules\\electron\\dist\\electron.exe .\"",
    "electron:dev:mock": "cross-env MOCK_INSTRUMENTS=1 concurrently \"npm run start:backend\" \"cross-env BROWSER=none npm start\" \"wait-on tcp:3000 tcp:8000 && .\\node_modules\\electron\\dist\\electron.exe .\"",
    "electron:dev:remote": "cross-env VITE_BACKEND_PORT=8100 FRONTEND_PORT=3100 concurrently \"npm run start:backend:remote\" \"cross-env BROWSER=none npm run start:remote\" \"wait-on tcp:3100 tcp:8100 && .\\node_modules\\electron\\dist\\electron.exe .\"",
    "electron:dev:mock:remote": "cross-env MOCK_INSTRUMENTS=1 VITE_BACKEND_PORT=8100 FRONTEND_PORT=3100 concurrently \"npm run start:backend:remote\" \"cross-env BROWSER=none npm run start:remote\" \"wait-on tcp:3100 tcp:8100 && .\\node_modules\\electron\\dist\\electron.exe .\"",
    "seed-mock": "cd ../../Backend/ac_shunt && ..\\..\\venv\\Scripts\\python.exe manage.py seed_mock_calibration_session",
    "seed-uncertainty-mock": "cd ../../Backend/ac_shunt && ..\\..\\venv\\Scripts\\python.exe manage.py seed_uncertainty_mock",
    "serve:build": "concurrently \"npm run start:backend\" \"serve -s build -l 3000\"",
    "electron:build": "npm run build-python && npm run build && electron-builder",
    "build-python": "cd ../../Backend/ac_shunt && pyinstaller ac_shunt_backend.spec --noconfirm"
  },
  "build": {
    "appId": "com.navair.acshunt",
    "productName": "AC Shunt Calibration",
    "files": [
      "build/**/*",
      "public/electron.js"
    ],
    "directories": {
      "buildResources": "public"
    },
    "extraResources": [
      {
        "from": "../../Backend/ac_shunt/dist/ac_shunt_backend",
        "to": "ac_shunt_backend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^25.0.1",
    "serve": "^14.2.6",
    "vite": "^6.0.7",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.5"
  }
}
